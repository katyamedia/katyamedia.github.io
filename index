<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Досье: Прокопюк Екатерина Дмитриевна</title>
    <style>
        :root {
            --bg-color: #121214;
            --card-bg: #1a1a1e;
            --accent-color: #ff3b30;
            --text-main: #ffffff;
            --text-muted: #a0a0a5;
            --border-color: #2c2c35;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }

        .container {
            max-width: 700px;
            width: 100%;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid var(--accent-color);
            padding-bottom: 20px;
        }

        h1 {
            font-size: 2rem;
            margin: 0 0 10px 0;
            color: var(--text-main);
        }

        .subtitle {
            color: var(--accent-color);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.9rem;
            font-weight: bold;
        }

        .section {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 1.2rem;
            color: var(--accent-color);
            margin-top: 0;
            margin-bottom: 15px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 140px 1fr;
            gap: 10px;
        }

        .info-label {
            color: var(--text-muted);
            font-weight: 500;
        }

        .info-value {
            color: var(--text-main);
        }

        .info-value a {
            color: #34c759;
            text-decoration: none;
        }

        .info-value a:hover {
            text-decoration: underline;
        }

        .circle-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .circle-item {
            border-bottom: 1px solid var(--border-color);
            padding: 15px 0;
        }

        .circle-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .circle-item:first-child {
            padding-top: 0;
        }

        .username {
            font-weight: bold;
            color: #007aff;
            text-decoration: none;
            font-size: 1.1rem;
        }

        .username:hover {
            text-decoration: underline;
        }

        .role {
            display: inline-block;
            background-color: rgba(255, 59, 48, 0.15);
            color: var(--accent-color);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            margin-left: 10px;
            vertical-align: middle;
        }

        .quote {
            background-color: rgba(255, 255, 255, 0.03);
            border-left: 3px solid var(--text-muted);
            margin: 8px 0 0 0;
            padding: 8px 12px;
            font-style: italic;
            color: #d1d1d6;
            font-size: 0.95rem;
            border-radius: 0 4px 4px 0;
        }
        
        .placeholder-image {
            display: inline-block;
            background: #2c2c35;
            color: var(--text-muted);
            padding: 6px 12px;
            font-size: 0.85rem;
            border-radius: 4px;
            margin-top: 8px;
            border: 1px dashed #48484a;
        }
    </style>
</head>
